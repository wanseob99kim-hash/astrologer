/**
 * Cloudflare Workers 배포 설정.
 *
 * Next.js 앱을 OpenNext 로 변환해 Workers 에서 돌린다.
 * 빌드: npx opennextjs-cloudflare build
 * 배포: npx opennextjs-cloudflare deploy
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astrologer",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // 정식 주소. 도메인이 같은 Cloudflare 계정에 있어서 배포할 때 자동으로 연결되고
  // DNS 레코드와 인증서도 Cloudflare 가 만든다.
  "routes": [
    { "pattern": "birthstar.uk", "custom_domain": true },
    { "pattern": "www.birthstar.uk", "custom_domain": true }
  ],
  // 예전 주소(astrologer.wanseob99-kim.workers.dev)도 계속 열어 둔다.
  // 미들웨어가 정식 주소로 308 리다이렉트해 검색 점수가 새 주소로 모인다.
  "workers_dev": true,
  "vars": {
    // canonical·sitemap·hreflang 의 기준 주소.
    // 비워두면 localhost 가 색인에 박힌다 — 벤치마크 사이트가 저지른 실수.
    "SITE_URL": "https://birthstar.uk"
  }
}
