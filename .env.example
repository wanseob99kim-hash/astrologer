# 복사해서 .env.local 로 저장한 뒤 값을 채운다. .env.local 은 저장소에 올라가지 않는다.
# 배포(Cloudflare)에서는 같은 이름으로 시크릿을 넣는다:
#   npx wrangler secret put TOSS_SECRET_KEY
#   npx wrangler secret put REPORT_SIGNING_SECRET
# TOSS_CLIENT_KEY 와 BIZ_* 는 공개돼도 되는 값이라 wrangler.jsonc 의 vars 에 둬도 된다.

# ---------- 토스페이먼츠 ----------
# 개발자센터(developers.tosspayments.com) → 내 개발정보 → API 키
# test_ 로 시작하는 키는 실제 돈이 오가지 않는다. 사업자 정보 없이도 결제가 켜진다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ---------- 리포트 열람 서명 ----------
# 32자 이상 아무 무작위 문자열. 바꾸면 이미 발급한 리포트 링크가 전부 무효가 된다.
# 만들기:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REPORT_SIGNING_SECRET=

# ---------- 판매자 정보 (라이브 키일 때 필수) ----------
# 전자상거래법상 결제 화면에 표시해야 한다. 라이브 키인데 하나라도 비면 결제가 켜지지 않는다.
BIZ_NAME=
BIZ_OWNER=
BIZ_REG_NO=
BIZ_MAIL_ORDER_NO=
BIZ_CONTACT=

# ---------- 기타 ----------
GEMINI_API_KEY=
